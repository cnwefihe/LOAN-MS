# ─────────────────────────────────────────────────────────────────────────────
# Loan Management System: environment configuration
# Copy to .env.local (development) or set as App Service / container secrets.
# Never commit real values. In production source secrets from Azure Key Vault.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (no trailing slash). Used for SSO redirect and email links.
APP_BASE_URL=https://loans.example.edu.ng

# ── Database ────────────────────────────────────────────────────────────────
# Production: PostgreSQL 15+ (e.g. Azure Database for PostgreSQL Flexible Server).
# Leave unset in development to use the embedded PGlite database in ./.data/pglite.
DATABASE_URL=
DATABASE_POOL_MAX=10
# DATABASE_SSL=disable            # only for a local Postgres without TLS
# DB_AUTO_MIGRATE=true            # otherwise run `npm run db:migrate` during deployment

# ── Microsoft Entra ID single sign-on ───────────────────────────────────────
# App registration (single tenant) → Web redirect URI: {APP_BASE_URL}/api/auth/callback
# Delegated Graph permission: User.Read
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Only these email domains may sign in or be nominated as guarantors.
ALLOWED_EMAIL_DOMAINS=example.edu.ng
# Comma-separated emails granted Super Administrator on first sign-in (go-live bootstrap only).
BOOTSTRAP_SUPER_ADMIN_EMAILS=

# ── Secrets ─────────────────────────────────────────────────────────────────
# 32+ random bytes, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# 32 bytes base64 for AES-256-GCM encryption of documents and bank details:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key requires re-encrypting stored data; keep it in Key Vault and back it up.
DATA_ENCRYPTION_KEY=
# Bearer secret (32+ chars) for the daily scheduler calling POST /api/cron/servicing
CRON_SECRET=

# ── Email through Microsoft 365 (see docs/DEPLOYMENT.md section 5) ──────────
# graph = Microsoft Graph sendMail as the shared mailbox. Leave unset to record emails without sending.
EMAIL_TRANSPORT=
EMAIL_SENDER_ADDRESS=loans@example.edu.ng
# Recommended: a separate app registration for email. If unset, the ENTRA_* sign-in app is used.
EMAIL_GRAPH_TENANT_ID=
EMAIL_GRAPH_CLIENT_ID=
EMAIL_GRAPH_CLIENT_SECRET=
# National clouds only:
# GRAPH_BASE_URL=https://graph.microsoft.com
# ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com

# ── Document storage ───────────────────────────────────────────────────────
# local = encrypted files on disk (single server). azure = Azure Blob (see docs/INTEGRATIONS_SETUP.md §3).
STORAGE_BACKEND=local
STORAGE_DIR=./storage
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net   # with managed identity (preferred)
# AZURE_STORAGE_CONNECTION_STRING=                                      # alternative
# AZURE_STORAGE_CONTAINER=loan-documents

# ── Payroll API (optional; CSV import works without it) ────────────────────
# Contract documented in src/server/integrations/payroll.ts
PAYROLL_API_BASE_URL=
PAYROLL_API_KEY=
PAYROLL_LOAN_DEDUCTION_CODE=

# ── Development only ───────────────────────────────────────────────────────
# Enables the fixture-account sign-in on /login. Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN=false
